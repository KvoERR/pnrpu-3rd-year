<UserControl x:Class="KostyaBankApp.Views.CardEntryView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Height="500" Width="420">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9E9E9E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5" FocusManager.FocusedElement="{Binding ElementName=CardNumberTextBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input Area -->
        <StackPanel Grid.Row="0" Margin="40,20">
            <TextBlock Text="Номер карты" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,8"/>
            <TextBox x:Name="CardNumberTextBox"
                       Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Padding="12,10"
                       Margin="0,0,0,10"
                       BorderBrush="#BDBDBD"
                       BorderThickness="1"
                       FontFamily="Consolas, 'Courier New'"
                       MaxLength="16"
                       PreviewTextInput="CardNumberTextBox_PreviewTextInput"/>

            <TextBlock Text="PIN-код" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,8"/>
            <TextBox x:Name="PinCodeTextBox"
                       Text="{Binding PinCode, UpdateSourceTrigger=PropertyChanged}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Padding="12,10"
                       Margin="0,0,0,5"
                       BorderBrush="#BDBDBD"
                       BorderThickness="1"
                       FontFamily="Consolas, 'Courier New'"
                       MaxLength="4"
                       PreviewTextInput="PinCodeTextBox_PreviewTextInput"/>

            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#9E9E9E"
                       Margin="0,2,0,10"/>

            <Border Background="#FFEBEE" CornerRadius="6" Padding="10"
                    Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,10">
                <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="#C62828"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Button -->
        <Button Grid.Row="1" Content="Войти"
                Command="{Binding LoginCommand}"
                Margin="40,0,40,40" Height="48"
                IsEnabled="{Binding CanLogin}"/>
    </Grid>
</UserControl>
