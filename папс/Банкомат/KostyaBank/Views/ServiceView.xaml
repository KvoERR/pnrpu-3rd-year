<UserControl x:Class="KostyaBankApp.Views.ServiceView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Back button -->
        <Button Grid.Row="0"
                Content="← Назад"
                Margin="20"
                Padding="20,10"
                Background="#E0E0E0"
                Foreground="#333333"
                FontSize="14"
                FontWeight="SemiBold"
                BorderThickness="0"
                Cursor="Hand"
                Command="{Binding BackCommand}"/>
    </Grid>
</UserControl>
