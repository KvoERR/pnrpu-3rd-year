<Window x:Class="KostyaBankApp.Views.ServiceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KostyaBankApp.ViewModels"
        Title="Сервисные операции"
        Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B5E20" Padding="20">
            <TextBlock Text="Сервисные операции"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="{Binding CardInfo}"
                       FontSize="14"
                       Foreground="#666666"
                       Margin="0,0,0,10"/>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="30,20"
                    Margin="0,10">
                <TextBlock Text="Этот раздел в разработке."
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Back button -->
        <Button Grid.Row="2"
                Content="← Назад"
                Margin="20"
                Padding="20,10"
                Background="#E0E0E0"
                Foreground="#333333"
                FontSize="14"
                FontWeight="SemiBold"
                BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</Window>
