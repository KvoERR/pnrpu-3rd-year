<UserControl x:Class="KostyaBankApp.Views.GetFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KostyaBankApp.Views">
    <views:CardFormView HeaderTitle="🏧  Снятие наличных">
        <views:CardFormView.ContentTemplate>
            <DataTemplate>
                <StackPanel>
                    <TextBlock Text="Доступный баланс:" FontSize="12" Foreground="#757575"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}" FontSize="18" FontWeight="Bold"
                               Foreground="#1B5E20" Margin="0,0,0,15"/>
                    <TextBlock Text="Введите сумму снятия" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding WithdrawAmount, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18" FontWeight="SemiBold"
                             Padding="12,10"
                             BorderBrush="#BDBDBD" BorderThickness="1"
                             FontFamily="Consolas, 'Courier New'"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,15"/>
                </StackPanel>
            </DataTemplate>
        </views:CardFormView.ContentTemplate>
    </views:CardFormView>
</UserControl>
