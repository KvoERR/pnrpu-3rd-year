<Window x:Class="KostyaBankApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KostyaBankApp.ViewModels"
        xmlns:views="clr-namespace:KostyaBankApp.Views"
        Title="KostyaBank"
        Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CardEntryViewModel}">
            <views:CardEntryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <views:MainWindowView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServiceViewModel}">
            <views:ServiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShowFormViewModel}">
            <views:ShowFormView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GetFormViewModel}">
            <views:GetFormView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MoneyStorageViewModel}">
            <views:MoneyStorageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CardStorageViewModel}">
            <views:CardStorageView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Общий хедер -->
        <Border Grid.Row="0" Background="#1B5E20" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="White" CornerRadius="8" Width="36" Height="36">
                    <TextBlock Text="KB" Foreground="#1B5E20" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="KostyaBank" FontSize="20" FontWeight="Bold" Foreground="White"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Контент меняется здесь -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
