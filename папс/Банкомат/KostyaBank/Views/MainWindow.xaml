<Window x:Class="KostyaBankApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KostyaBankApp.ViewModels"
        Title="KostyaBank — Главное меню"
        Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:MainMenuViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="BorderBrush" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ExitButton">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="#1B5E20" CornerRadius="10" Width="45" Height="45">
                    <TextBlock Text="KB" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="KostyaBank" FontSize="20" FontWeight="Bold" Foreground="#1B5E20"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="White" CornerRadius="10" Margin="0,15,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="Ваша карта:" FontSize="11" Foreground="#9E9E9E"/>
                    <TextBlock Text="{Binding MaskedCardNumber}"
                               FontSize="16" FontWeight="SemiBold" Foreground="#333333"
                               FontFamily="Consolas, 'Courier New'" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Menu Buttons -->
        <StackPanel Grid.Row="1" Margin="20,20">
            <Button Content="💰  Баланс" Style="{StaticResource ResourceKey=MenuButton}"
                    Command="{Binding BalanceCommand}"/>
            <Button Content="📥  Пополнить" Style="{StaticResource ResourceKey=MenuButton}"
                    Command="{Binding DepositCommand}"/>
            <Button Content="🏧  Снять" Style="{StaticResource ResourceKey=MenuButton}"
                    Command="{Binding WithdrawCommand}"/>
            <Button Content="📋  История операций" Style="{StaticResource ResourceKey=MenuButton}"
                    Command="{Binding HistoryCommand}"/>
            <Button Content="⚙️  Настройки" Style="{StaticResource ResourceKey=MenuButton}"
                    Command="{Binding SettingsCommand}"/>
        </StackPanel>

        <!-- Exit -->
        <Button Grid.Row="2" Content="🚪  Выйти из аккаунта"
                Style="{StaticResource ResourceKey=ExitButton}"
                Command="{Binding ExitCommand}"/>
    </Grid>
</Window>
