<UserControl x:Class="KostyaBankApp.Views.CardStorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:KostyaBankApp.Models"
             Height="500" Width="520">

    <UserControl.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9E9E9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C62828"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9E9E9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="BackButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="BorderBrush" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B5E20" Padding="20">
            <TextBlock Text="🏧  Хранилище карт" FontSize="18" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <!-- Card count -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Всего карт в хранилище:" FontSize="14" Foreground="#757575"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CountText}" FontSize="32" FontWeight="Bold" Foreground="#1B5E20"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Cards list -->
                <TextBlock Text="Список карт:" FontSize="14" Foreground="#424242"
                           Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="8" Padding="10"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Width="400" Height="150" Margin="0,0,0,15">
                    <ListView ItemsSource="{Binding Cards}" BorderThickness="0"
                              Background="Transparent" FontSize="13">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="models:Card">
                                <StackPanel Margin="5">
                                    <TextBlock FontWeight="SemiBold">
                                        <TextBlock Text="{Binding CardNumber}"/>
                                        <TextBlock Text="  "/>
                                        <TextBlock Foreground="#757575">
                                            <TextBlock Text="{Binding HolderName}"/>
                                        </TextBlock>
                                    </TextBlock>
                                    <TextBlock Foreground="#1B5E20" FontWeight="SemiBold">
                                        <TextBlock Text="Баланс: "/>
                                        <TextBlock Text="{Binding Balance, StringFormat={}{0:C2}}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <Button Content="🗑  Очистить всё"
                            Style="{StaticResource ResourceKey=DangerButton}"
                            Command="{Binding ClearCommand}"
                            IsEnabled="{Binding CanExecuteClear}"
                            Width="160" Height="44"/>

                <!-- Status message -->
                <Border Background="#E3F2FD" CornerRadius="6" Padding="10"
                        BorderBrush="#90CAF9" BorderThickness="1"
                        Visibility="{Binding StatusVisibility}"
                        Margin="0,0,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#1565C0"
                               TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Back Button -->
        <Button Grid.Row="2" Content="←  Назад в меню" Style="{StaticResource BackButton}"
                Command="{Binding BackCommand}"
                Height="44" Margin="0,0,0,20"/>
    </Grid>
</UserControl>
