<UserControl x:Class="KostyaBankApp.Views.ShowFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KostyaBankApp.Views"
             Height="500" Width="420">
    <views:CardFormView HeaderTitle="💳  Баланс карты">
        <views:CardFormView.ContentTemplate>
            <DataTemplate>
                <StackPanel>
                    <Border Height="1" Background="#E0E0E0" Margin="0,5,0,15"/>
                    <TextBlock Text="Доступный баланс" FontSize="12" Foreground="#9E9E9E"
                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}" FontSize="28" FontWeight="Bold"
                               Foreground="#1B5E20" HorizontalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </views:CardFormView.ContentTemplate>
    </views:CardFormView>
</UserControl>
