<Window x:Class="DrawERR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawERR.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Графический редактор" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Встроенный конвертер -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Универсальный шаблон: линии между точками + кружки в точках -->
        <DataTemplate x:Key="ShapeTemplate">
            <Canvas>
                <!-- Прозрачная подложка для захвата кликов -->
                <Rectangle Fill="Transparent"
                           Width="{Binding Bounds.Width}"
                           Height="{Binding Bounds.Height}"
                           Canvas.Left="{Binding Bounds.X}"
                           Canvas.Top="{Binding Bounds.Y}"/>

                <!-- Линии между точками -->
                <Polyline Stroke="Black"
                          StrokeThickness="{Binding StrokeThickness}"
                          StrokeLineJoin="Round"
                          Points="{Binding ClosedPoints}"
                          Fill="Transparent"/>

                <!-- Кружки в каждой точке -->
                <ItemsControl ItemsSource="{Binding TransformedPoints}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10"
                                    Margin="-5,-5,0,0"
                                    Fill="Black"
                                    Stroke="White"
                                    StrokeThickness="1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Рамка выделения -->
                <Rectangle Stroke="Blue" StrokeThickness="2"
                           StrokeDashArray="4,2" Fill="Transparent"
                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="{Binding Bounds.Width}"/>
                            <Setter Property="Height" Value="{Binding Bounds.Height}"/>
                            <Setter Property="Canvas.Left" Value="{Binding Bounds.X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}"/>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
            </Canvas>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Верхняя панель -->
        <ToolBar Grid.Row="0" Grid.ColumnSpan="3" Margin="5">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5"/>
            <Button Content="Загрузить" Command="{Binding LoadCommand}" Padding="10,5"/>
            <Separator/>
            <Button Content="Удалить" Command="{Binding DeleteShapeCommand}" Padding="10,5"/>
            <Button Content="Очистить" Command="{Binding ClearCommand}" Padding="10,5"/>
            <Separator/>
            <Button Content="◄" Command="{Binding MoveLeftCommand}" Padding="10,5"/>
            <Button Content="►" Command="{Binding MoveRightCommand}" Padding="10,5"/>
            <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,5"/>
            <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,5"/>
            <Separator/>
            <Button Content="⟲" Command="{Binding RotateLeftCommand}" Padding="10,5"/>
            <Button Content="⟳" Command="{Binding RotateRightCommand}" Padding="10,5"/>
            <Separator/>
            <Button Content="🔍+" Command="{Binding ScaleUpCommand}" Padding="10,5"/>
            <Button Content="🔍-" Command="{Binding ScaleDownCommand}" Padding="10,5"/>
        </ToolBar>

        <!-- Левая панель -->
        <Border Grid.Row="1" Grid.Column="0" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Элементы" 
                           FontWeight="Bold" 
                           Margin="10"/>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Shapes}"
                         SelectedItem="{Binding SelectedShape}"
                         Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Border Grid.Row="1" Grid.Column="1" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Margin="5"
                Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Shapes}"
                              ItemTemplate="{StaticResource ShapeTemplate}"
                              PreviewMouseLeftButtonDown="ItemsControl_PreviewMouseLeftButtonDown">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                        <Canvas Width="800" 
                                Height="600"
                                Background="White">
                            <Canvas.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DeselectAllCommand}"/>
                            </Canvas.InputBindings>
                        </Canvas>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Правая панель свойств -->
        <Border Grid.Row="1" Grid.Column="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Свойства"
                           FontWeight="Bold"
                           Margin="10"/>

                <ScrollViewer Grid.Row="1" Margin="5" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Информация о фигуре -->
                        <TextBlock Text="Фигура:" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding SelectedShape.DisplayName, FallbackValue='Не выбрано'}"
                                   Margin="5,0"/>

                        <!-- Позиция -->
                        <TextBlock Text="Позиция:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="X:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedShape.X, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5,0"/>
                        </Grid>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Y:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedShape.Y, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5,0"/>
                        </Grid>

                        <!-- Поворот -->
                        <TextBlock Text="Поворот:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Угол:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedShape.RotationAngle, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5,0"/>
                        </Grid>

                        <!-- Масштаб -->
                        <TextBlock Text="Масштаб:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Размер:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedShape.ScaleFactor, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5,0"/>
                        </Grid>

                        <!-- Граница (Bounding Box) -->
                        <TextBlock Text="Bounding Box:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBlock Margin="5,0"
                                   Text="{Binding SelectedShape.Bounds, FallbackValue='Не выбрано'}"/>

                        <!-- Цвет заливки -->
                        <TextBlock Text="Заливка:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="20" Height="20" Margin="5,0"
                                       Fill="{Binding SelectedShape.Fill, FallbackValue=Transparent}"
                                       Stroke="Gray" StrokeThickness="1"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedShape.Fill, FallbackValue='Прозрачный'}"
                                       VerticalAlignment="Center" Margin="5,0"/>
                        </Grid>

                        <!-- Цвет границы -->
                        <TextBlock Text="Граница (цвет):" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="20" Height="20" Margin="5,0"
                                       Fill="{Binding SelectedShape.Stroke, FallbackValue=Black}"
                                       Stroke="Gray" StrokeThickness="1"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedShape.Stroke, FallbackValue='Чёрный'}"
                                       VerticalAlignment="Center" Margin="5,0"/>
                        </Grid>

                        <!-- Толщина границы -->
                        <TextBlock Text="Толщина границы:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedShape.StrokeThickness, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Grid.ColumnSpan="3"
                BorderBrush="Gray" 
                BorderThickness="1" 
                Margin="5"
                Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фигура: " VerticalAlignment="Center" Margin="5"/>

                <ComboBox ItemsSource="{Binding ShapeTypes}"
                          SelectedItem="{Binding SelectedShapeType}"
                          Width="120"
                          Margin="5"/>

                <Button Content="Добавить" 
                        Command="{Binding AddShapeCommand}" 
                        Padding="15,5"
                        Margin="10,5"/>

                <TextBlock Text=" | " VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Text="Информация: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedShape.DisplayName, FallbackValue='Не выбрано'}" 
                           VerticalAlignment="Center" 
                           Margin="5,0"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>